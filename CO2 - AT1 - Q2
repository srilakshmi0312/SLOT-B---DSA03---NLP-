words = ["unhappy", "happiness", "happily"]

data = {
    "unhappy": ("un", "happy", "-", "Derivational", "happy"),
    "happiness": ("-", "happy", "ness", "Derivational", "happy"),
    "happily": ("-", "happy", "ly", "Derivational", "happy")
}

print("{:<12}{:<10}{:<12}{:<10}{:<18}{:<15}".format(
    "Word",
    "Prefix",
    "Base",
    "Suffix",
    "Type",
    "Normalized"
))

print("-" * 80)

for word in words:
    prefix, base, suffix, morph_type, normalized = data[word]
    print("{:<12}{:<10}{:<12}{:<10}{:<18}{:<15}".format(
        word,
        prefix,
        base,
        suffix,
        morph_type,
        normalized
    ))
