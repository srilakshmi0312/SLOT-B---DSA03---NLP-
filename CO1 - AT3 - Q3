import re

text = """Meeting on 12/09/2026
Call 9876543210
Email support@gmail.com
OpenAI develops AI
#NLP
@OpenAI
natural language processing"""

while True:

    print("\n1. Search Date")
    print("2. Search Phone Number")
    print("3. Search Hashtag")
    print("4. Search Mention")
    print("5. Search Prefix")
    print("6. Search Suffix")
    print("7. Exit")

    choice = input("Enter Choice: ")

    if choice == "1":
        print(re.findall(r"\b\d{2}/\d{2}/\d{4}\b", text))

    elif choice == "2":
        print(re.findall(r"\b[6-9]\d{9}\b", text))

    elif choice == "3":
        print(re.findall(r"#\w+", text))

    elif choice == "4":
        print(re.findall(r"@\w+", text))

    elif choice == "5":
        pre = input("Enter Prefix: ")
        print(re.findall(r"\b" + pre + r"\w*", text))

    elif choice == "6":
        suf = input("Enter Suffix: ")
        print(re.findall(r"\b\w*" + suf + r"\b", text))

    elif choice == "7":
        print("Program Closed")
        break

    else:
        print("Invalid Choice")
