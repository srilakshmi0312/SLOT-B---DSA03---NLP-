words = ["analyzing", "analysis", "analytical"]

print("Morphological Processing Report")
print("-" * 80)
print("{:<15}{:<12}{:<12}{:<15}{:<15}".format(
    "Word", "Root", "Affix", "Type", "Normalized"))

for word in words:

    if word == "analyzing":
        root = "analyze"
        affix = "-ing"
        mtype = "Inflectional"

    elif word == "analysis":
        root = "analyze"
        affix = "-sis"
        mtype = "Derivational"

    elif word == "analytical":
        root = "analyze"
        affix = "-ical"
        mtype = "Derivational"

    print("{:<15}{:<12}{:<12}{:<15}{:<15}".format(
        word, root, affix, mtype, root))
