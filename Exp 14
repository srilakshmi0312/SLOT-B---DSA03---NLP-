subjects = {
    "He": "singular",
    "She": "singular",
    "John": "singular",
    "They": "plural",
    "We": "plural"
}

verbs = {
    "runs": "singular",
    "eats": "singular",
    "run": "plural",
    "eat": "plural"
}

sentence = input("Enter a sentence: ").split()

if len(sentence) != 2:
    print("Invalid sentence")
else:
    subject = sentence[0]
    verb = sentence[1]

    if subject in subjects and verb in verbs:
        if subjects[subject] == verbs[verb]:
            print("Agreement Correct")
        else:
            print("Agreement Incorrect")
    else:
        print("Word not found")
