from collections import Counter
import math

train = "the student is studying the student is reading the teacher is teaching"
test = "the student is reading the teacher is studying"

tr = train.split()
te = test.split()

uni = Counter(tr)
bi = Counter(zip(tr, tr[1:]))
tri = Counter(zip(tr, tr[1:], tr[2:]))

def entropy(n):
    values = []

    for i in range(len(te)):
        if n == 1:
            p = uni[te[i]] / len(tr)

        elif n == 2:
            p = bi[(te[i-1], te[i])] / uni[te[i-1]] if i > 0 and uni[te[i-1]] else 0

        else:
            p = tri[(te[i-2], te[i-1], te[i])] / bi[(te[i-2], te[i-1])] if i > 1 and bi[(te[i-2], te[i-1])] else 0

        if p > 0:
            values.append(-math.log2(p))

    return sum(values) / len(values)

print("Unigram Entropy:", round(entropy(1), 3))
print("Bigram Entropy:", round(entropy(2), 3))
print("Trigram Entropy:", round(entropy(3), 3))

print("\nLower entropy = more predictable")
print("Higher entropy = more uncertain")
